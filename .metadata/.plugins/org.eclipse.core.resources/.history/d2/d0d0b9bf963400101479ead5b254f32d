// Function to convert decimal to BCD (for DS3231)
uint8_t DECtoBCD(uint8_t dec) {
    return ((dec / 10) << 4) | (dec % 10);
}

// Function to write time/date to DS3231
void DS3231_SetDateTime(uint8_t sec, uint8_t min, uint8_t hour, uint8_t day, uint8_t date, uint8_t month, uint8_t year) {
    uint8_t data[7];

    data[0] = DECtoBCD(sec);      // Seconds (0x00)
    data[1] = DECtoBCD(min);      // Minutes (0x01)
    data[2] = DECtoBCD(hour);     // Hours (0x02, 24-hour mode)
    data[3] = DECtoBCD(day);      // Day of week (1-7, 0x03)
    data[4] = DECtoBCD(date);     // Date (0x04)
    data[5] = DECtoBCD(month);    // Month (0x05)
    data[6] = DECtoBCD(year);     // Year (0x06)

    // Write all 7 registers at once
    HAL_I2C_Mem_Write(&hi2c1, DS3231_ADDRESS << 1, 0x00, I2C_MEMADD_SIZE_8BIT, data, 7, 100);
}

// Function to set DS3231 time from compilation timestamp
void DS3231_SetTimeFromCompilation(void) {
    const char *compile_date = __DATE__; // "May 19 2025"
    const char *compile_time = __TIME__; // "15:30:45"

    struct tm timeinfo = {0};
    char month_str[4];
    int day, year, hour, min, sec;

    // Parse __DATE__ (e.g., "May 19 2025")
    sscanf(compile_date, "%s %d %d", month_str, &day, &year);
    sscanf(compile_time, "%d:%d:%d", &hour, &min, &sec);

    // Convert month name to number (1-12)
    const char *months[] = {"Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"};
    for (int i = 0; i < 12; i++) {
        if (strcmp(month_str, months[i]) == 0) {
            timeinfo.tm_mon = i + 1; // DS3231 expects 1-12
            break;
        }
    }

    timeinfo.tm_mday = day;
    timeinfo.tm_year = year - 2000; // DS3231 expects 00-99 (2000-2099)
    timeinfo.tm_hour = hour;
    timeinfo.tm_min = min;
    timeinfo.tm_sec = sec;

    // Set DS3231 time
    DS3231_SetDateTime(
        timeinfo.tm_sec, timeinfo.tm_min, timeinfo.tm_hour,
        1, // Day of week (1-7, optional)
        timeinfo.tm_mday, timeinfo.tm_mon, timeinfo.tm_year
    );
}

// Function to read DS3231 time (unchanged from your original code)
uint8_t BCDtoDEC(uint8_t bcd) {
    return ((bcd >> 4) * 10) + (bcd & 0x0F);
}

void DS3231_GetDateTime(uint8_t *sec, uint8_t *min, uint8_t *hour, uint8_t *day, uint8_t *date, uint8_t *month, uint8_t *year) {
    uint8_t data[7];
    HAL_I2C_Mem_Read(&hi2c1, DS3231_ADDRESS << 1, 0x00, I2C_MEMADD_SIZE_8BIT, data, 7, 100);

    *sec = BCDtoDEC(data[0] & 0x7F);
    *min = BCDtoDEC(data[1]);
    *hour = BCDtoDEC(data[2] & 0x3F);
    *day = BCDtoDEC(data[3]);
    *date = BCDtoDEC(data[4]);
    *month = BCDtoDEC(data[5] & 0x1F);
    *year = BCDtoDEC(data[6]);
}

