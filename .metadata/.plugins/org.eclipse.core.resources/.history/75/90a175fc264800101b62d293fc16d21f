/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{
  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_USART1_UART_Init();
  MX_USART2_UART_Init();
  MX_I2C1_Init();
  /* USER CODE BEGIN 2 */

  //Initialize RTC
  Set_Time(00, 20, 10, 1, 20, 5, 25);

  //Turn OFF Valve and cmd to turn off valve
  HAL_GPIO_WritePin(GPIOB, GPIO_PIN_13, 0);
  HAL_UART_Transmit(&huart2, &cmd_off_motor, 1, HAL_MAX_DELAY);

  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */

	  // Get current time from RTC
	  Get_Time();

      //Check if current time between 6AM and 6PM
//      if (hour == 10 && minutes >= 21 && minutes < 22)
   if (hour >= 6 && hour < 18)
   {
	  modbus_tx_data(); // Perform Modbus communication to read sensor data
	  // Control the motor based on moisture level
	  if (moisture <= MOISTURE_LOWER_THRESHOLD)
	  {
		  HAL_GPIO_WritePin(GPIOB, GPIO_PIN_13, 1); // Turn ON Valve
		  HAL_Delay(1000);
		  HAL_UART_Transmit(&huart2, &cmd_on_motor, 1, HAL_MAX_DELAY);// Send command to turn ON Motor
	  }
	  else if (moisture >= MOISTURE_UPPER_THRESHOLD)
	  {
		  HAL_UART_Transmit(&huart2, &cmd_off_motor, 1, HAL_MAX_DELAY);// Send command to turn OFF Motor
		  HAL_Delay(1000);
		  HAL_GPIO_WritePin(GPIOB, GPIO_PIN_13, 0);// Turn OFF Valve
	  }
     }
     else
     {
          // Outside operational hours (6 PM to 6 AM)
          // Ensure the motor is turned OFF
          HAL_UART_Transmit(&huart2, &cmd_off_motor, 1, HAL_MAX_DELAY);
          HAL_Delay(1000);
          // Turn OFF Valve
          HAL_GPIO_WritePin(GPIOB, GPIO_PIN_13, 0);
      }

      // Delay before the next iteration
      HAL_Delay(1000);

  }
  /* USER CODE END 3 */
}

