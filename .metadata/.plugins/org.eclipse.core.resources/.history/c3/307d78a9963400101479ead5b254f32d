	// Function to write a single register to DS3231
	void DS3231_WriteRegister(uint8_t reg, uint8_t value) {
		HAL_I2C_Mem_Write(&hi2c1, DS3231_ADDRESS << 1, reg, I2C_MEMADD_SIZE_8BIT, &value, 1, 100);
	}

	// Function to convert decimal to BCD
	uint8_t DECtoBCD(uint8_t dec) {
		return ((dec / 10) << 4) | (dec % 10);
	}

	// Function to set the current time and date on DS3231
	void DS3231_SetDateTime(uint8_t seconds, uint8_t minutes, uint8_t hours,
							uint8_t dayOfWeek, uint8_t date, uint8_t month, uint8_t year) {
		uint8_t data[7];

		// Convert decimal values to BCD
		data[0] = DECtoBCD(seconds);      // Seconds
		data[1] = DECtoBCD(minutes);      // Minutes
		data[2] = DECtoBCD(hours);        // Hours (24-hour mode)
		data[3] = DECtoBCD(dayOfWeek);    // Day of the week (1–7)
		data[4] = DECtoBCD(date);         // Date
		data[5] = DECtoBCD(month);        // Month
		data[6] = DECtoBCD(year);         // Year

		// Write data to DS3231 registers
		HAL_I2C_Mem_Write(&hi2c1, DS3231_ADDRESS << 1, 0x00, I2C_MEMADD_SIZE_8BIT, data, 7, 100);
	}

	// Function to automatically set the DS3231 time using __DATE__ and __TIME__
	void DS3231_SetCompilationTime(void) {
		uint8_t seconds, minutes, hours, day, date, month, year;

		// Extract compilation time (__TIME__ format: "HH:MM:SS")
		sscanf(__TIME__, "%d:%d:%d", &hours, &minutes, &seconds);

		// Extract compilation date (__DATE__ format: "MMM DD YYYY")
		char monthStr[4];
		sscanf(__DATE__, "%s %d %d", monthStr, &date, &year);

		// Convert year to 2-digit format
		year %= 100;

		// Convert month name to number
		if (strcmp(monthStr, "Jan") == 0) month = 1;
		else if (strcmp(monthStr, "Feb") == 0) month = 2;
		else if (strcmp(monthStr, "Mar") == 0) month = 3;
		else if (strcmp(monthStr, "Apr") == 0) month = 4;
		else if (strcmp(monthStr, "May") == 0) month = 5;
		else if (strcmp(monthStr, "Jun") == 0) month = 6;
		else if (strcmp(monthStr, "Jul") == 0) month = 7;
		else if (strcmp(monthStr, "Aug") == 0) month = 8;
		else if (strcmp(monthStr, "Sep") == 0) month = 9;
		else if (strcmp(monthStr, "Oct") == 0) month = 10;
		else if (strcmp(monthStr, "Nov") == 0) month = 11;
		else if (strcmp(monthStr, "Dec") == 0) month = 12;

		// Determine the day of the week (1 = Monday, ..., 7 = Sunday)
		// Zeller's Congruence algorithm
		int k = year % 100;
		int j = year / 100;
		int h = (date + (13 * (month + 1)) / 5 + k + (k / 4) + (j / 4) - (2 * j)) % 7;
		day = (h + 5) % 7 + 1;  // Adjust to match DS3231 day numbering (1 = Monday)

		// Set the DS3231 time and date
		DS3231_SetDateTime(seconds, minutes, hours, day, date, month, year);
	}

	// Function to read a single register from DS3231
	uint8_t DS3231_ReadRegister(uint8_t reg) {
		uint8_t data;
		HAL_I2C_Mem_Read(&hi2c1, DS3231_ADDRESS << 1, reg, I2C_MEMADD_SIZE_8BIT, &data, 1, 100);
		return data;
	}

	// Function to convert BCD to decimal
	uint8_t BCDtoDEC(uint8_t bcd) {
		return ((bcd >> 4) * 10) + (bcd & 0x0F);
	}

	// Function to get the current time and date from DS3231
	void DS3231_GetDateTime(uint8_t *seconds, uint8_t *minutes, uint8_t *hours,
							uint8_t *day, uint8_t *date, uint8_t *month, uint8_t *year) {
		uint8_t data[7];

		// Read all time/date registers (0x00 to 0x06)
		HAL_I2C_Mem_Read(&hi2c1, DS3231_ADDRESS << 1, 0x00, I2C_MEMADD_SIZE_8BIT, data, 7, 100);

		// Convert BCD to decimal
		*seconds = BCDtoDEC(data[0] & 0x7F);  // Mask out CH (Clock Halt) bit
		*minutes = BCDtoDEC(data[1]);
		*hours = BCDtoDEC(data[2] & 0x3F);    // 24-hour mode
		*day = BCDtoDEC(data[3]);             // Day of the week (1–7)
		*date = BCDtoDEC(data[4]);
		*month = BCDtoDEC(data[5] & 0x1F);    // Mask out century bit
		*year = BCDtoDEC(data[6]);
	}


